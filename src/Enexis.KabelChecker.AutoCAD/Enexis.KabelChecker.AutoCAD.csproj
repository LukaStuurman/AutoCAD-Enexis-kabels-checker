<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AutoCADApiSeries Condition="'$(AutoCADApiSeries)' == ''">R25</AutoCADApiSeries>
    <TargetFramework Condition="'$(AutoCADApiSeries)' == 'R26'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(AutoCADApiSeries)' != 'R26'">net8.0-windows</TargetFramework>
    <AutoCADNuGetVersion Condition="'$(AutoCADApiSeries)' == 'R26'">26.0.0</AutoCADNuGetVersion>
    <AutoCADNuGetVersion Condition="'$(AutoCADApiSeries)' != 'R26'">25.0.1</AutoCADNuGetVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Enexis.KabelChecker.AutoCAD</AssemblyName>
    <RootNamespace>Enexis.KabelChecker.AutoCAD</RootNamespace>
    <AutoCADManagedDir Condition="'$(AutoCADManagedDir)' == '' and '$(AutoCADApiSeries)' == 'R26'">C:\Program Files\Autodesk\AutoCAD 2027</AutoCADManagedDir>
    <AutoCADManagedDir Condition="'$(AutoCADManagedDir)' == '' and '$(AutoCADApiSeries)' != 'R26'">C:\Program Files\Autodesk\AutoCAD 2025</AutoCADManagedDir>
    <UseAutoCADNuGet Condition="'$(UseAutoCADNuGet)' == ''">false</UseAutoCADNuGet>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <Target Name="ValidateAutoCADApiSeries" BeforeTargets="PrepareForBuild" Condition="'$(AutoCADApiSeries)' != 'R25' and '$(AutoCADApiSeries)' != 'R26'">
    <Error Text="AutoCADApiSeries moet R25 (AutoCAD 2025/2026) of R26 (AutoCAD 2027+) zijn." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Enexis.KabelChecker.Core\Enexis.KabelChecker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Eea-0205.K 1.0 - Copy.xlsx" />
    <EmbeddedResource Include="Resources\Eea-0205.K 2.0.xlsx" />
    <EmbeddedResource Include="Resources\Eea-0205.K 3.2.xlsx" />
    <Compile Remove="CurrentLoadPanel.cs" />
    <Compile Remove="KabelCheckerForm.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseAutoCADNuGet)' == 'true'">
    <PackageReference Include="AutoCAD.NET" Version="$(AutoCADNuGetVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseAutoCADNuGet)' != 'true'">
    <Reference Include="AcCoreMgd">
      <HintPath>$(AutoCADManagedDir)\AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AutoCADManagedDir)\AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcMgd">
      <HintPath>$(AutoCADManagedDir)\AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
